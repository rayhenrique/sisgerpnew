[Unit]
Description=SISGERP
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/sisgerp/current
EnvironmentFile=/etc/sisgerp.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT
SyslogIdentifier=sisgerp

[Install]
WantedBy=multi-user.target
